# =============================================================================
# Django VMS - Example environment file (safe to commit; NO real values here)
# Copy to .env and fill in real values. .env is git-ignored.
# =============================================================================

# --- Core Django ---
# Secret used for signing sessions/JWTs. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=changeme-generate-a-real-secret-key
# 'True' enables DEBUG mode - must be 'False' in production.
DJANGO_DEBUG=True

# --- Database ---
# 'True' = local SQLite file; 'False' = PostgreSQL (start_backend.ps1 -UsePostgres sets this too).
DJANGO_USE_SQLITE=True
# SQLite filename, only used when DJANGO_USE_SQLITE=True.
SQLITE_DB_NAME=db_locations.sqlite3
# PostgreSQL settings, only used when DJANGO_USE_SQLITE=False.
DB_NAME=vms_db
DB_USER=vms_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Email backend ---
# smtp backend for real email; locmem keeps emails in memory (useful for testing).
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# --- Gate pass email notification (SMTP) ---
# SMTP server that delivers the gate pass copy to the manager's inbox.
GATEPASS_EMAIL_HOST=smtp.example.com
GATEPASS_EMAIL_PORT=587
# Account the notification is sent from.
GATEPASS_EMAIL_USER=notifications@yourcompany.com
# Password/app-password for that account.
GATEPASS_EMAIL_PASSWORD=changeme
# Recipient: the dedicated gate pass management inbox.
GATEPASS_MANAGER_EMAIL=recipient@yourcompany.com
